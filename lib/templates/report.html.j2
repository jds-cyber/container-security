<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="utf-8">
<title>Container Security Report</title>

<style>

body{
    font-family: Arial, sans-serif;
    background:#f4f4f4;
    margin:40px;
    color:#333;
}

.container{
    max-width:900px;
    margin:auto;
}

.card{
    background:white;
    border-radius:8px;
    padding:20px;
    margin-bottom:20px;
    box-shadow:0 2px 6px rgba(0,0,0,.15);
}

h1,h2{
    margin-top:0;
}

.metric{
    font-size:3em;
    font-weight:bold;
    color:#1f4e79;
    margin:10px 0;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

th{
    background:#f0f0f0;
    text-align:left;
}

td,th{
    padding:10px;
    border-bottom:1px solid #ddd;
}

.status-pass{
    color:#198754;
    font-weight:bold;
}

.status-fail{
    color:#dc3545;
    font-weight:bold;
}

.grade{
    font-size:1.5em;
    font-weight:bold;
}

.footer{
    text-align:center;
    color:#777;
    font-size:.9em;
    margin-top:30px;
}

</style>

</head>

<body>

<div class="container">

    <div class="card">

        <h1>Container Security Report</h1>

        <p><strong>Container Image:</strong> {{ image }}</p>

        <p><strong>Generated:</strong> {{ generated }}</p>

        <p>
            <strong>Policy Status:</strong>

            {% if passed %}
                <span class="status-pass">PASS</span>
            {% else %}
                <span class="status-fail">FAIL</span>
            {% endif %}
        </p>

    </div>

    <div class="card">

        <h2>Overall Security Score</h2>

        <div class="metric">
            {{ summary.security_score }} / 100
        </div>

        <p>
            <strong>Security Grade:</strong>

            <span class="grade">

                {% if summary.grade == "A" %}
                    <span class="status-pass">A</span>

                {% elif summary.grade == "B" %}
                    <span style="color:#2E8B57;font-weight:bold;">B</span>

                {% elif summary.grade == "C" %}
                    <span style="color:#DAA520;font-weight:bold;">C</span>

                {% elif summary.grade == "D" %}
                    <span style="color:#FF8C00;font-weight:bold;">D</span>

                {% else %}
                    <span class="status-fail">F</span>

                {% endif %}

            </span>
        </p>

        <p>

    <div class="card">

        <h2>Severity Overview</h2>
        {{ bar_chart | safe }}

    </div>

    <div class="card">

        <h2>Severity Distribution</h2>
        {{ pie_chart | safe }}

    </div>

            <strong>Weighted Risk:</strong>

            {{ summary.weighted_risk }}

        </p>

    </div>

    <div class="card">

        <h2>Severity Summary</h2>

        <table>

            <tr>
                <th>Severity</th>
                <th>Count</th>
            </tr>

            <tr>
                <td>Critical</td>
                <td>{{ summary.critical }}</td>
            </tr>

            <tr>
                <td>High</td>
                <td>{{ summary.high }}</td>
            </tr>

            <tr>
                <td>Medium</td>
                <td>{{ summary.medium }}</td>
            </tr>

            <tr>
                <td>Low</td>
                <td>{{ summary.low }}</td>
            </tr>

            <tr>
                <td>Negligible</td>
                <td>{{ summary.negligible }}</td>
            </tr>

            <tr>
                <td>Unknown</td>
                <td>{{ summary.unknown }}</td>
            </tr>

            <tr>
                <th>Total Findings</th>
                <th>{{ summary.findings }}</th>
            </tr>

            <tr>
                <th>Unique Vulnerabilities</th>
                <th>{{ summary.unique_vulnerabilities }}</th>
            </tr>

        </table>

    </div>

    <div class="card">

        <h2>Executive Summary</h2>

        <p>
            This container image contains
            <strong>{{ summary.findings }}</strong>
            vulnerability findings, representing
            <strong>{{ summary.unique_vulnerabilities }}</strong>
            unique vulnerabilities.
        </p>

        <p>
            The calculated security score is
            <strong>{{ summary.security_score }}/100</strong>
            (Grade {{ summary.grade }}).
        </p>

        {% if summary.critical > 0 %}

        <p>
            <strong>Immediate action recommended:</strong>
            This image contains
            <strong>{{ summary.critical }}</strong>
            critical vulnerabilities that should be remediated before deployment.
        </p>

        {% elif summary.high > 0 %}

        <p>
            No critical vulnerabilities were detected, but
            high-severity findings should be addressed promptly.
        </p>

        {% else %}

        <p>
            No critical or high-severity vulnerabilities were detected.
        </p>

    {% endif %}

    </div>

    <div class="footer">
        Generated automatically by the Container Security Pipeline
    </div>

</div>

</body>
</html>