<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="utf-8">
<title>Container Security Report</title>

<style>

body{
    font-family: Arial, sans-serif;
    background:#f4f4f4;
    margin:40px;
    color:#333;
}

.container{
    max-width:900px;
    margin:auto;
}

.card{
    background:white;
    border-radius:8px;
    padding:20px;
    margin-bottom:20px;
    box-shadow:0 2px 6px rgba(0,0,0,.15);
}

h1,h2{
    margin-top:0;
}

.metric{
    font-size:3em;
    font-weight:bold;
    color:#1f4e79;
    margin:10px 0;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

th{
    background:#f0f0f0;
    text-align:left;
}

td,th{
    padding:10px;
    border-bottom:1px solid #ddd;
}

.status-pass{
    color:#198754;
    font-weight:bold;
}

.status-fail{
    color:#dc3545;
    font-weight:bold;
}

.grade{
    font-size:1.5em;
    font-weight:bold;
}

.footer{
    text-align:center;
    color:#777;
    font-size:.9em;
    margin-top:30px;
}

</style>

</head>
<body>

{% macro severity_change(delta) %}
    {% if delta < 0 %}
        <span class="status-pass">{{ delta }}</span>
    {% elif delta > 0 %}
        <span class="status-fail">+{{ delta }}</span>
    {% else %}
        <span>{{ delta }}</span>
    {% endif %}
{% endmacro %}

<div class="container">
    <div class="card">
        <h1>Container Security Report</h1>
        <h2>Scan Information</h2>

        <p><strong>Container Image:</strong> {{ image }}</p>
        <p><strong>Generated:</strong> {{ generated }}</p>
        <p><strong>Scan ID:</strong> {{ scan_id }}</p>
        <p><strong>Scan Timestamp:</strong> {{ scan_timestamp }}</p>

        <p>
            <strong>Policy Status:</strong>
            {% if passed %}
                <span class="status-pass">PASS</span>
            {% else %}
                <span class="status-fail">FAIL</span>
            {% endif %}
        </p>

        {% if policy_failures %}
            <h3>Policy Failures</h3>
            <ul>
                {% for failure in policy_failures %}
                    <li class="status-fail">{{ failure }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div class="card">
        <h2>Overall Security Score</h2>
        <div class="metric">
            {{ summary.security_score }} / 100
        </div>
        <p>
            <strong>Security Grade:</strong>
            <span class="grade">
                {% if summary.grade == "A" %}
                    <span class="status-pass">A</span>

                {% elif summary.grade == "B" %}
                    <span style="color:#2E8B57;font-weight:bold;">B</span>

                {% elif summary.grade == "C" %}
                    <span style="color:#DAA520;font-weight:bold;">C</span>

                {% elif summary.grade == "D" %}
                    <span style="color:#FF8C00;font-weight:bold;">D</span>

                {% else %}
                    <span class="status-fail">F</span>
                {% endif %}
            </span>
        </p>
        <p>
        <strong>Weighted Risk:</strong>
            {{ summary.weighted_risk }}
        </p>
    </div>

    <div class="card">
        <h2>Security Comparison</h2>
        {% if comparison %}
            <p>
                <strong>Previous Score:</strong>
                {{ comparison.score.previous }}
            </p>
            <p>
                <strong>Current Score:</strong>
                {{ comparison.score.current }}
            </p>
            <p>
                <strong>Change:</strong>
                {{ comparison.score.delta }}
            </p>
            <p>
                <strong>Trend:</strong>
                {{ comparison.score.trend }}
            </p>
            <p>
                <strong>New Vulnerabilities:</strong>
                {{ comparison.vulnerabilities.new | length }}
            </p>
            <p>
                <strong>Fixed Vulnerabilities:</strong>
                {{ comparison.vulnerabilities.fixed | length }}
            </p>
            <p>
                <strong>Unchanged Vulnerabilities:</strong>
                {{ comparison.vulnerabilities.unchanged | length }}
            </p>
            <p>
                <strong>Severity Findings Removed:</strong>
                {{ comparison.severity_summary.improved }}
            </p>
            <p>
                <strong>Severity Findings Added:</strong>
                {{ comparison.severity_summary.regressed }}
            </p>

            <h3 style="margin-top: 25px;">Severity Comparison</h3>
            <table>
                <tr>
                    <th>Severity</th>
                    <th>Previous</th>
                    <th>Current</th>
                    <th>Change</th>
                </tr>
                <tr>
                    <td>Critical</td>
                    <td>{{ comparison.severity.critical.previous }}</td>
                    <td>{{ comparison.severity.critical.current }}</td>
                    <td>{{ severity_change(comparison.severity.critical.delta) }}</td>
                </tr>
                <tr>
                    <td>High</td>
                    <td>{{ comparison.severity.high.previous }}</td>
                    <td>{{ comparison.severity.high.current }}</td>
                    <td>{{ severity_change(comparison.severity.high.delta) }}</td>
                </tr>
                <tr>
                    <td>Medium</td>
                    <td>{{ comparison.severity.medium.previous }}</td>
                    <td>{{ comparison.severity.medium.current }}</td>
                    <td>{{ severity_change(comparison.severity.medium.delta) }}</td>
                </tr>
                <tr>
                    <td>Low</td>
                    <td>{{ comparison.severity.low.previous }}</td>
                    <td>{{ comparison.severity.low.current }}</td>
                    <td>{{ severity_change(comparison.severity.low.delta) }}</td>
                </tr>
                <tr>
                    <td>Negligible</td>
                    <td>{{ comparison.severity.negligible.previous }}</td>
                    <td>{{ comparison.severity.negligible.current }}</td>
                    <td>{{ severity_change(comparison.severity.negligible.delta) }}</td>
                </tr>
                <tr>
                    <td>Unknown</td>
                    <td>{{ comparison.severity.unknown.previous }}</td>
                    <td>{{ comparison.severity.unknown.current }}</td>
                    <td>{{ severity_change(comparison.severity.unknown.delta) }}</td>
                </tr>
            </table>

            <h3 style="margin-top: 25px;">Intelligence Comparison</h3>
            <table>
                <tr>
                    <th>Metric</th>
                    <th>Previous</th>
                    <th>Current</th>
                    <th>Change</th>
                </tr>
                <tr>
                    <td>Total Vulnerabilities</td>
                    <td>{{ comparison.intelligence.total.previous }}</td>
                    <td>{{ comparison.intelligence.total.current }}</td>
                    <td>{{ comparison.intelligence.total.delta }}</td>
                </tr>
                <tr>
                    <td>Enriched</td>
                    <td>{{ comparison.intelligence.enriched.previous }}</td>
                    <td>{{ comparison.intelligence.enriched.current }}</td>
                    <td>{{ comparison.intelligence.enriched.delta }}</td>
                </tr>
                <tr>
                    <td>Unenriched</td>
                    <td>{{ comparison.intelligence.unenriched.previous }}</td>
                    <td>{{ comparison.intelligence.unenriched.current }}</td>
                    <td>{{ comparison.intelligence.unenriched.delta }}</td>
                </tr>
                <tr>
                    <td>CVSS Available</td>
                    <td>{{ comparison.intelligence.cvss_available.previous }}</td>
                    <td>{{ comparison.intelligence.cvss_available.current }}</td>
                    <td>{{ comparison.intelligence.cvss_available.delta }}</td>
                </tr>
                <tr>
                    <td>CWE Available</td>
                    <td>{{ comparison.intelligence.cwe_available.previous }}</td>
                    <td>{{ comparison.intelligence.cwe_available.current }}</td>
                    <td>{{ comparison.intelligence.cwe_available.delta }}</td>
                </tr>
                <tr>
                    <td>High CVSS</td>
                    <td>{{ comparison.intelligence.high_cvss.previous }}</td>
                    <td>{{ comparison.intelligence.high_cvss.current }}</td>
                    <td>{{ comparison.intelligence.high_cvss.delta }}</td>
                </tr>
                <tr>
                    <td>High EPSS</td>
                    <td>{{ comparison.intelligence.high_epss.previous }}</td>
                    <td>{{ comparison.intelligence.high_epss.current }}</td>
                    <td>{{ comparison.intelligence.high_epss.delta }}</td>
                </tr>
                <tr>
                    <td>High EPSS Percentile</td>
                    <td>{{ comparison.intelligence.high_epss_percentile.previous }}</td>
                    <td>{{ comparison.intelligence.high_epss_percentile.current }}</td>
                    <td>{{ comparison.intelligence.high_epss_percentile.delta }}</td>
                </tr>
                <tr>
                    <td>Affected Package</td>
                    <td>{{ comparison.intelligence.affected_package.previous }}</td>
                    <td>{{ comparison.intelligence.affected_package.current }}</td>
                    <td>{{ comparison.intelligence.affected_package.delta }}</td>
                </tr>
            </table>

        {% else %}
            <p>No previous scan available for comparison.</p>
        {% endif %}
    </div>

    <div class="card">
        <h2>Severity Overview</h2>
        {{ bar_chart | safe }}
    </div>

    <div class="card">
        <h2>Severity Distribution</h2>
        {{ pie_chart | safe }}
    </div>

    <div class="card">
        <h2>Severity Summary</h2>
        <table>
            <tr>
                <th>Severity</th>
                <th>Count</th>
            </tr>
            <tr>
                <td>Critical</td>
                <td>{{ summary.critical }}</td>
            </tr>
            <tr>
                <td>High</td>
                <td>{{ summary.high }}</td>
            </tr>
            <tr>
                <td>Medium</td>
                <td>{{ summary.medium }}</td>
            </tr>
            <tr>
                <td>Low</td>
                <td>{{ summary.low }}</td>
            </tr>
            <tr>
                <td>Negligible</td>
                <td>{{ summary.negligible }}</td>
            </tr>
            <tr>
                <td>Unknown</td>
                <td>{{ summary.unknown }}</td>
            </tr>
            <tr>
                <th>Total Findings</th>
                <th>{{ summary.findings }}</th>
            </tr>
            <tr>
                <th>Unique Vulnerabilities</th>
                <th>{{ summary.unique_vulnerabilities }}</th>
            </tr>
        </table>
    </div>

    <div class="card">
        <h2>Vulnerability Intelligence Coverage</h2>

        <table>
            <tr>
                <th>Metric</th>
                <th>Count</th>
            </tr>
            <tr>
                <td>Total Vulnerabilities</td>
                <td>{{ summary.intelligence_summary.total }}</td>
            </tr>
            <tr>
                <td>Enriched</td>
                <td>{{ summary.intelligence_summary.enriched }}</td>
            </tr>
            <tr>
                <td>Unenriched</td>
                <td>{{ summary.intelligence_summary.unenriched }}</td>
            </tr>
            <tr>
                <td>CVSS Available</td>
                <td>{{ summary.intelligence_summary.cvss_available }}</td>
            </tr>
            <tr>
                <td>CWE Available</td>
                <td>{{ summary.intelligence_summary.cwe_available }}</td>
            </tr>
            <tr>
                <td>High CVSS</td>
                <td>{{ summary.intelligence_summary.high_cvss }}</td>
            </tr>
            <tr>
                <td>High EPSS</td>
                <td>{{ summary.intelligence_summary.high_epss }}</td>
            </tr>
            <tr>
                <td>High EPSS Percentile</td>
                <td>{{ summary.intelligence_summary.high_epss_percentile }}</td>
            </tr>
            <tr>
                <td>Affected Package</td>
                <td>{{ summary.intelligence_summary.affected_package }}</td>
            </tr>
        </table>
    </div>

    <div class="card">
        <h2>Vulnerability Intelligence</h2>

        {% if summary.vulnerabilities %}
            {% for vulnerability in summary.vulnerabilities %}
                <div style="margin-bottom: 30px;">

                    <h3>{{ vulnerability.id }}</h3>

                    <table>
                        <tr>
                            <th>Severity</th>
                            <td>{{ vulnerability.severity }}</td>
                        </tr>

                        {% if vulnerability.package %}
                        <tr>
                            <th>Package</th>
                            <td>{{ vulnerability.package }}</td>
                        </tr>
                        {% endif %}

                        {% if vulnerability.installed_version %}
                        <tr>
                            <th>Installed Version</th>
                            <td>{{ vulnerability.installed_version }}</td>
                        </tr>
                        {% endif %}

                        {% if vulnerability.fixed_version %}
                        <tr>
                            <th>Fixed Version</th>
                            <td>{{ vulnerability.fixed_version }}</td>
                        </tr>
                        {% endif %}
                    </table>

                    {% if vulnerability.intelligence %}

                    <h4>Intelligence</h4>

                    {% if vulnerability.intelligence.description %}
                    <p>
                        <strong>Description:</strong>
                        {{ vulnerability.intelligence.description }}
                    </p>
                    {% endif %}

                    {% if vulnerability.intelligence.cvss %}
                    <table>
                        <tr>
                            <th>CVSS Version</th>
                            <td>{{ vulnerability.intelligence.cvss.version }}</td>
                        </tr>

                        <tr>
                            <th>CVSS Score</th>
                            <td>{{ vulnerability.intelligence.cvss.score }}</td>
                        </tr>

                        {% if vulnerability.intelligence.cvss.severity %}
                        <tr>
                            <th>CVSS Severity</th>
                            <td>{{ vulnerability.intelligence.cvss.severity }}</td>
                        </tr>
                        {% endif %}

                        {% if vulnerability.intelligence.cvss.vector %}
                        <tr>
                            <th>CVSS Vector</th>
                            <td>{{ vulnerability.intelligence.cvss.vector }}</td>
                        </tr>
                        {% endif %}
                    </table>
                    {% endif %}

                    {% if vulnerability.intelligence.cwe %}
                    <p>
                        <strong>CWE:</strong>
                        {{ vulnerability.intelligence.cwe | join(", ") }}
                    </p>
                    {% endif %}

                    {% if vulnerability.intelligence.published %}
                    <p>
                        <strong>Published:</strong>
                        {{ vulnerability.intelligence.published }}
                    </p>
                    {% endif %}

                    {% if vulnerability.intelligence.modified %}
                    <p>
                        <strong>Last Modified:</strong>
                        {{ vulnerability.intelligence.modified }}
                    </p>
                    {% endif %}

                    {% if vulnerability.intelligence.aliases %}
                    <p>
                        <strong>Aliases:</strong>
                        {{ vulnerability.intelligence.aliases | join(", ") }}
                    </p>
                    {% endif %}

                    {% if vulnerability.intelligence.affected_packages %}
                    <h4>Affected Packages</h4>

                    <table>
                        <tr>
                            <th>Ecosystem</th>
                            <th>Package</th>
                        </tr>

                        {% for package in vulnerability.intelligence.affected_packages %}
                        <tr>
                            <td>{{ package.ecosystem }}</td>
                            <td>{{ package.name }}</td>
                        </tr>
                        {% endfor %}
                    </table>
                    {% endif %}

                    {% if vulnerability.intelligence.references %}
                    <p>
                        <strong>References:</strong>
                    </p>

                    <ul>
                        {% for reference in vulnerability.intelligence.references %}
                        <li>
                            <a href="{{ reference }}" target="_blank" rel="noopener noreferrer">
                                {{ reference }}
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}

                    {% if vulnerability.intelligence.risk_summary %}
                    <h4>Risk Indicators</h4>

                    <table>
                        <tr>
                            <th>Indicator Count</th>
                            <td>{{ vulnerability.intelligence.risk_summary.indicator_count }}</td>
                        </tr>

                        {% if vulnerability.intelligence.risk_summary.indicators %}
                        <tr>
                            <th>Indicators</th>
                            <td>
                                {{ vulnerability.intelligence.risk_summary.indicators | join(", ") }}
                            </td>
                        </tr>
                        {% endif %}
                    </table>
                    {% endif %}

                    {% else %}
                    <p>
                        <strong>Intelligence:</strong>
                        No vulnerability intelligence available.
                    </p>
                    {% endif %}

                {% if vulnerability.intelligence.remediation %}
                <h4>Remediation</h4>

                <table>
                <tr>
                    <th>Exploitation Likelihood</th>
                    <td>
                        {{ vulnerability.intelligence.remediation.exploitation_likelihood }}
                    </td>
                    </tr>

                <tr>
                    <th>Known Exploitation</th>
                    <td>
                        {{ vulnerability.intelligence.remediation.known_exploitation }}
                    </td>
                </tr>

                <tr>
                    <th>Priority</th>
                    <td>
                        {{ vulnerability.intelligence.remediation.priority }}
                    </td>
                </tr>
            </table>

            {% if vulnerability.intelligence.remediation.guidance %}
            <p>
                <strong>Guidance:</strong>
                {{ vulnerability.intelligence.remediation.guidance }}
            </p>
            {% endif %}
            {% endif %}  

                </div>
            {% endfor %}
        {% else %}
            <p>No vulnerabilities detected.</p>
        {% endif %}
    </div>

    <div class="card">
        <h2>Executive Summary</h2>
        <p>
            This container image contains
            <strong>{{ summary.findings }}</strong>
            vulnerability findings, representing
            <strong>{{ summary.unique_vulnerabilities }}</strong>
            unique vulnerabilities.
        </p>
        <p>
            The calculated security score is
            <strong>{{ summary.security_score }}/100</strong>
            (Grade {{ summary.grade }}).
        </p>
        {% if summary.critical > 0 %}
        <p>
            <strong>Immediate action recommended:</strong>
            This image contains
            <strong>{{ summary.critical }}</strong>
            critical vulnerabilities that should be remediated before deployment.
        </p>
        {% elif summary.high > 0 %}
        <p>
            No critical vulnerabilities were detected, but
            high-severity findings should be addressed promptly.
        </p>
        {% else %}
        <p>
            No critical or high-severity vulnerabilities were detected.
        </p>
    {% endif %}
    </div>

    <div class="card">
    <h2>Security Score Trend</h2>
    {{ trend_chart | safe }}
    </div>

    <div class="footer">
        Generated automatically by the Container Security Pipeline
    </div>
</div>

</body>
</html>