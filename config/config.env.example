# Scanning Images
GRYPE_IMAGE=registry.access.redhat.com/hi/grype:latest

# Certificate
# Set this to a locally supplied corporate CA certificate if required.
CERT_FILE=certs/corporate-ca.crt

# Output
REPORT_DIR=reports
LOG_DIR=logs
SBOM_DIR=sbom
CACHE_DIR=cache

# Severity Gate
FAIL_LEVEL=high

# Behavior
UPDATE_DB=true
QUIET=true
COLOR=true
